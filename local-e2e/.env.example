# Copy this file to .env and fill in values before running E2E tests.
# E2E tests require a running api-server + web-manager (npm run dev:stack or npm run start).

# App URL — built single server (default: https://localhost:8080)
# For Vite dev server use: http://localhost:5173
BASE_URL=https://localhost:8080

# Credentials for an existing user account
E2E_USERNAME=admin
E2E_PASSWORD=

# DB name used by async_jobs tests (default: demodb)
# E2E_DB=demodb
