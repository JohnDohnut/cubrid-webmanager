# Copy this file to .env and fill in values before running E2E tests.
# E2E tests require a running api-server + web-manager (npm run dev:stack or npm run start).

# App URL (default: http://localhost:5173 for Vite dev server)
# For HTTPS stack use: https://localhost:443
# For built server use: https://localhost:8080
BASE_URL=http://localhost:5173

# Credentials for an existing user account
E2E_USERNAME=admin
E2E_PASSWORD=

# CUBRID host registered in the app (used by DB/broker tests)
E2E_HOST_LABEL=
