# Copy to apps/api-server/.env or repo root .env (see README — Environment variables).
# Production servers often use /etc/cubrid-webmanager.env instead.

# --- api-server (required) ---
ENVIRONMENT=development
SEED=
SALT=
PORT=8080

# --- api-server (production CORS) ---
# Comma-separated, no spaces. Must match browser Origin exactly (https://localhost has no :443).
# ALLOWED_ORIGINS=https://example.com,https://www.example.com

# --- api-server (optional) ---
# AUTH_REGISTRATION_ENABLED=true
# JWT access token: 1d, refresh token: 14d (see token.constants.ts)
# CMS_REJECT_UNAUTHORIZED=true
# CMS_FORWARD_ENABLED=false
# CMS_CA_CERT_PATH=/path/to/cms-ca.pem
# LISTEN_HOST=0.0.0.0
# LISTEN_UNIX_SOCKET=/path/to/api.sock
# STORAGE_PATH=/path/to/storage
# CWM_SSL_DIR=/path/to/ssl
# SERVER_IP=192.168.1.10
# CWM_TRUST_LOCAL_PROXY=1

# --- TLS (production: required; development: optional — auto self-signed if missing) ---
# Local: npm run ssl:local-prod
# SSL_CERT_PATH=apps/api-server/ssl/cert.pem
# SSL_KEY_PATH=apps/api-server/ssl/key.pem

# --- Local HTTPS stack (tools/serve-web-manager-https-proxy.js) ---
# PROXY_INSECURE_TLS=1
# API_TARGET=https://127.0.0.1:8080
# WEB_HTTPS_PORT=443
# BUILD_DIR=dist/apps/web-manager

# --- Desktop (set by Electron main; override only for debugging) ---
# CWM_DESKTOP=1
# CWM_DESKTOP_ALLOWED_ORIGIN=app://.
