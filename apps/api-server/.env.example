# Copy to .env (pkg: next to binary; dev: project cwd).
# production: /etc/cubrid-webmanager.env

ENVIRONMENT=development
SEED=
SALT=

PORT=8080
# ALLOWED_ORIGINS=https://example.com

# production 로컬 테스트: 루트에서 `npm run ssl:local-prod` 후
# SSL_CERT_PATH=apps/api-server/ssl/cert.pem
# SSL_KEY_PATH=apps/api-server/ssl/key.pem
# 서버 배포 시 예시:
# SSL_CERT_PATH=/etc/ssl/cubrid-webmanager/fullchain.pem
# SSL_KEY_PATH=/etc/ssl/cubrid-webmanager/privkey.pem
