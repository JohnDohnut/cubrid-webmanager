{
  "name": "api-server",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api-server/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "args": ["--node-env=production"],
        "cwd": "apps/api-server"
      },
      "configurations": {
        "development": {
          "args": ["--node-env=development"]
        }
      }
    },
    "prune-lockfile": {
      "dependsOn": ["build"],
      "cache": true,
      "executor": "@nx/js:prune-lockfile",
      "outputs": [
        "{workspaceRoot}/dist/apps/api-server/package.json",
        "{workspaceRoot}/dist/apps/api-server/package-lock.json"
      ],
      "options": {
        "buildTarget": "build"
      }
    },
    "copy-workspace-modules": {
      "dependsOn": ["build"],
      "cache": true,
      "outputs": ["{workspaceRoot}/dist/apps/api-server/workspace_modules"],
      "executor": "@nx/js:copy-workspace-modules",
      "options": {
        "buildTarget": "build"
      }
    },
    "prune": {
      "dependsOn": ["prune-lockfile", "copy-workspace-modules"],
      "executor": "nx:noop"
    },
    "serve": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "command": "node dist/apps/api-server/main.js",
        "cwd": "{workspaceRoot}"
      }
    },
    "test": {
      "options": {
        "passWithNoTests": true
      }
    },
    "build:exe": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "commands": [
          {
            "command": "npm install --production",
            "cwd": "dist/apps/api-server"
          },
          {
            "command": "node scripts/prepare-pkg-manifest.js",
            "cwd": "apps/api-server"
          },
          {
            "command": "npx pkg dist/apps/api-server/package.json",
            "cwd": "{workspaceRoot}"
          }
        ],
        "parallel": false
      },
      "configurations": {
        "windows": {
          "commands": [
            {
              "command": "npm install --production",
              "cwd": "dist/apps/api-server"
            },
            {
              "command": "node scripts/prepare-pkg-manifest.js --target node18-win-x64",
              "cwd": "apps/api-server"
            },
            {
              "command": "npx pkg dist/apps/api-server/package.json --targets node18-win-x64 --output dist/executables/api-server.exe",
              "cwd": "{workspaceRoot}"
            }
          ],
          "parallel": false
        },
        "linux": {
          "commands": [
            {
              "command": "npm install --production",
              "cwd": "dist/apps/api-server"
            },
            {
              "command": "node scripts/prepare-pkg-manifest.js --target node18-linux-x64",
              "cwd": "apps/api-server"
            },
            {
              "command": "npx pkg dist/apps/api-server/package.json --targets node18-linux-x64 --output dist/executables/api-server-linux",
              "cwd": "{workspaceRoot}"
            }
          ],
          "parallel": false
        },
        "macos": {
          "commands": [
            {
              "command": "npm install --production",
              "cwd": "dist/apps/api-server"
            },
            {
              "command": "node scripts/prepare-pkg-manifest.js --target node18-macos-x64",
              "cwd": "apps/api-server"
            },
            {
              "command": "npx pkg dist/apps/api-server/package.json --targets node18-macos-x64 --output dist/executables/api-server-macos",
              "cwd": "{workspaceRoot}"
            }
          ],
          "parallel": false
        },
        "all": {
          "commands": [
            {
              "command": "npm install --production",
              "cwd": "dist/apps/api-server"
            },
            {
              "command": "node scripts/prepare-pkg-manifest.js --set-bin",
              "cwd": "apps/api-server"
            },
            {
              "command": "npx pkg dist/apps/api-server/package.json",
              "cwd": "{workspaceRoot}"
            }
          ],
          "parallel": false
        }
      }
    }
  }
}
